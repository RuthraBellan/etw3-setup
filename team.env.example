# ETW III — per-team config for setup.sh
#
# setup.sh copies this to team.env on first run if team.env doesn't exist
# yet. Edit the copy (team.env), not this file — team.env is git-ignored
# so teams don't accidentally commit each other's values.

# Your team's own ROS 2 workspace repo (the "team repo template" you
# forked/cloned). Leave blank before S2 if it doesn't exist yet — setup.sh
# will skip that step and you can re-run later.
TEAM_REPO_URL=""
