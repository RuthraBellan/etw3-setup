# ETW III — per-team config for setup.sh
#
# setup.sh copies this to team.env on first run if team.env doesn't exist
# yet. Edit the copy (team.env), not this file — team.env is git-ignored
# so teams don't accidentally commit each other's values.

# Your team's own ROS 2 workspace repo (the "team repo template" you
# forked/cloned). Leave blank before S2 if it doesn't exist yet — setup.sh
# will skip that step and you can re-run later.
TEAM_REPO_URL=""

# Where the instructor's prebuilt libcamera package is hosted.
# Same URL for every team — copy this from the S1 setup guide.
LIBCAMERA_PKG_URL="https://github.com/<org>/etw3-setup/releases/download/libcamera-prebuilt/libcamera-noble-arm64.tar.gz"

# camera_ros source repo, built locally against the prebuilt libcamera
# above. Same URL for every team.
CAMERA_ROS_REPO="https://github.com/christianrauch/camera_ros.git"
